# Copy to an untracked file. Names only. Never commit values.
# Do not use .env — this worktree's .env is production.
# Recipients are official Resend simulated-delivery addresses, not real inboxes.

DEPOSIT_STAGING_MODE=1
DEPOSIT_STAGING_CUSTOMER_EMAIL=delivered+deposit-customer@resend.dev
DEPOSIT_STAGING_HBW_EMAIL=delivered+deposit-hbw@resend.dev
DEPOSIT_STAGING_GROK_EMAIL=delivered+deposit-grok@resend.dev
# Failure/retry may replace exactly one of the three with:
# DEPOSIT_STAGING_CUSTOMER_EMAIL=bounced+deposit-retry@resend.dev

STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_WEBHOOK_SECRET=
STAGING_RESEND_API_KEY=
STAGING_ADMIN_ACCESS_TOKEN=
STAGING_DATABASE_URL=
VERCEL_PREVIEW_URL=
# Isolated Edge secret only (not used by this runner). Name only; never commit a value:
# STRIPE_DEPOSIT_PRICE_500=
# Hosted bootstrap nonce is operator intent acknowledgement only; it does not
# identify the connected project. Target project_id ccozickwrpautlxknsjk externally:
